{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vexaro-website",
  "main": "worker/vexaro-production.mjs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/*.html", "/live/", "/live/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
