{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vexaro-website",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}